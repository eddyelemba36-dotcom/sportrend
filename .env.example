# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odds_aggregator
POSTGRES_USER=odds_user
POSTGRES_PASSWORD=odds_pass
DATABASE_URL=postgresql://odds_user:odds_pass@localhost:5432/odds_aggregator

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=odds_user
RABBITMQ_PASS=odds_pass
RABBITMQ_URL=amqp://odds_user:odds_pass@localhost:5672

# Gateway
GATEWAY_PORT=3000
API_KEY=odds-api-key-2024

# Services
LIVE_SERVICE_PORT=3001
ODDS_SERVICE_PORT=3002
MATCH_EVENTS_SERVICE_PORT=3003
STATISTICS_SERVICE_PORT=3004
SETTLEMENT_SERVICE_PORT=3005

# 1xBet
ONEXBET_BASE_URL=https://1xbet.com
ONEXBET_RATE_LIMIT=1
ONEXBET_TIMEOUT=30000
ONEXBET_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
NODE_ENV=development
